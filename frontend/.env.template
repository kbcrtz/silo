# Copy to .env. EXPO_PUBLIC_ values are inlined into the JS bundle at build time.

# Backend for color analysis and try-on generation. Unused while mocks are on.
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8080

# Supabase project for Apple / Google sign-in (supabase-js). The publishable key
# is safe in the app: Silo's tables have RLS on with no policies, so it reads
# nothing; the backend does all data access. Local stack: `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# true = color analysis and try-on use the in-app mocks in src/api/.
EXPO_PUBLIC_USE_MOCKS=true
