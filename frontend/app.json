{
  "expo": {
    "name": "Silo",
    "slug": "silo",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "silo",
      "com.googleusercontent.apps.517103856921-ki5vhqblgb7p2jamcl2l0saqi8vpn2cf"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.siloapp.ios",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "Q724R9Q8UC"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Silo uses your photos for your color analysis and try-on body photo.",
          "cameraPermission": "Silo uses the camera to take your color analysis selfie and try-on body photo.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "cover",
          "backgroundColor": "#FFFCFB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9e59557-aa83-407d-8487-33e9fd20da06"
      }
    },
    "owner": "kbcrtz"
  }
}
