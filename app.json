{
  "expo": {
    "name": "Silo",
    "slug": "silo",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "silo",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.siloapp.ios",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "Q724R9Q8UC"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Silo uses your photos for your color analysis and try-on body photo.",
          "cameraPermission": "Silo uses the camera to take your color analysis selfie and try-on body photo.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9e59557-aa83-407d-8487-33e9fd20da06"
      }
    },
    "owner": "kbcrtz"
  }
}
