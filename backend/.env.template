# Copy to .env. Never put GEMINI_API_KEY in the Expo app.
GEMINI_API_KEY=
# Signs feed cursors. Any random string of at least 16 characters; never shipped in the app.
CURSOR_SECRET=

# Supabase. Local stack: `supabase start`, then `supabase status` prints these.
# The project must use asymmetric JWT signing keys (login tokens are checked against its JWKS).
SUPABASE_URL=http://127.0.0.1:54321
# Secret key (sb_secret_... or the legacy service_role key), for account deletion. Never in the app.
SUPABASE_SECRET_KEY=
# Anonymous Supabase logins (the app's silent sign-in) count as signed in. Set false once Apple/Google sign-in ships.
ALLOW_ANONYMOUS=true
# Sign in with Apple token revocation when an account is deleted (Apple requires it). From Apple Developer >
# Keys, a key with "Sign in with Apple" enabled. The .p8 contents may be on one line with \n. Optional.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CLIENT_ID=com.siloapp.ios
# Postgres connection string. Hosted: add ?sslmode=require. Local default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
PORT=8080

# Shopify Global Catalog (anonymous; no key). Defaults shown.
# SHOPIFY_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
# CATALOG_COUNTRY=US
# CATALOG_TIMEOUT_MS=8000
# Gemini reads each feed page's listing text for color and cut (one call per page). off disables it.
# CATALOG_AI=off
# CATALOG_AI_TIMEOUT_MS=3000
# CATALOG_AI_MODEL=gemini-3.5-flash-lite

# Gemini model for AI try-on images (GET /catalog/tryon-image). Default shown.
# TRYON_IMAGE_MODEL=gemini-3.1-flash-lite-image
